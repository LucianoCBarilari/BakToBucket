# ── Cloudflare R2 ──────────────────────────────────────────────────────────────
R2_ACCESS_KEY=your_access_key
R2_SECRET_KEY=your_secret_key
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=backups

# ── SQL Server ─────────────────────────────────────────────────────────────────
DB_CONNECTION_STRING=Server=localhost;Database=your_db;User Id=dev_readonly;Password=******;TrustServerCertificate=True

# ── Databases to backup (comma-separated) ──────────────────────────────────────
INCLUDED_DATABASES=DB1,DB2,DB3

# ── Backup schedule ────────────────────────────────────────────────────────────
BACKUP_INTERVAL_HOURS=24
BACKUP_SCHEDULE_RUN_AT_HOUR=2
BACKUP_SCHEDULE_RUN_AT_MINUTE=0

# ── Backup folder ──────────────────────────────────────────────────────────────
BACKUP_FOLDER=C:\Backups

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_FOLDER_PATH=Logs
LOG_FILE_NAME=log.txt
LOG_MINIMUM_LEVEL=Information