# Logging
LogOptions__FolderPath=Logs
LogOptions__FileName=log.txt
LogOptions__MinimumLevel=Information

# Cloudflare R2 / S3 Storage
StorageOptions__AccessKey=your_access_key
StorageOptions__SecretKey=your_secret_key
StorageOptions__Endpoint=https://<account_id>.r2.cloudflarestorage.com
StorageOptions__BucketName=backups

# Database Connections
ConnectionStrings__SqlServer=Server=localhost;Database=master;User Id=sa;Password=your_password;TrustServerCertificate=True
ConnectionStrings__PostgreSql=Host=localhost;Database=master;Username=user;Password=your_password

# Application Settings
AppOptions__DatabaseType=SqlServer
AppOptions__BackupHostName=MyServer
AppOptions__EngineBackupPath=./Backups
AppOptions__LocalBackupPath=
AppOptions__ZipOutputPath=Archives
AppOptions__LocalOnly=false
AppOptions__BackupIntervalHours=24
AppOptions__Schedule__RunAtHour=2
AppOptions__Schedule__RunAtMinute=0
AppOptions__IncludedDatabases=Db1,Db2
