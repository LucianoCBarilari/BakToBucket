# -----------------------------------------------------------------------------
# BakToBucket Environment Configuration
# -----------------------------------------------------------------------------
# In .NET, nested JSON properties in appsettings.json are mapped to environment 
# variables using the double-underscore (__). If you define these variables in 
# your .env file, they will OVERRIDE the values in appsettings.json.
# -----------------------------------------------------------------------------

# --- LOGGING ---
LogOptions__FolderPath=Logs
LogOptions__FileName=log.txt
LogOptions__MinimumLevel=Information

# --- CLOUDFLARE R2 / S3 STORAGE ---
StorageOptions__AccessKey=your_access_key
StorageOptions__SecretKey=your_secret_key
StorageOptions__Endpoint=https://<account_id>.r2.cloudflarestorage.com
StorageOptions__BucketName=backups
RetentionOptions__MaxBucketSizeGB=10

# --- CORE APPLICATION ---
AppOptions__BackupHostName=MyServer
AppOptions__ZipOutputPath=Archives
AppOptions__LocalOnly=false
AppOptions__BackupIntervalHours=24
AppOptions__Schedule__RunAtHour=2
AppOptions__Schedule__RunAtMinute=0

# --- SQL SERVER CONFIGURATION ---
AppOptions__Engines__sqlserver__Enabled=true
AppOptions__Engines__sqlserver__EngineBackupPath=/var/opt/mssql/backup
AppOptions__Engines__sqlserver__LocalBackupPath=/app/sql_backups
# Arrays are defined using numeric indexes:
AppOptions__Engines__sqlserver__IncludedDatabases__0=Db1
AppOptions__Engines__sqlserver__IncludedDatabases__1=Db2
# The Connection String for SQL Server
ConnectionStrings__sqlserver=Server=host.docker.internal;Database=master;User Id=sa;Password=your_password;TrustServerCertificate=True;

# --- POSTGRESQL CONFIGURATION ---
AppOptions__Engines__postgresql__Enabled=false
AppOptions__Engines__postgresql__EngineBackupPath=/var/lib/postgresql/backup
AppOptions__Engines__postgresql__LocalBackupPath=/app/pg_backups
# Arrays are defined using numeric indexes:
AppOptions__Engines__postgresql__IncludedDatabases__0=Db1
# The Connection String for PostgreSQL
ConnectionStrings__postgresql=Host=host.docker.internal;Port=5432;Database=postgres;Username=postgres;Password=your_password;
